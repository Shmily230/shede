# 复制为 .env 后按需修改；docker compose 会自动读取
MYSQL_ROOT_PASSWORD=123456

# 支付宝沙箱（不填也能启动，只是无法真正唤起收银台）
ALIPAY_APP_ID=2021000000000000
ALIPAY_PRIVATE_KEY=YOUR_APP_PRIVATE_KEY_PLACEHOLDER
ALIPAY_PUBLIC_KEY=YOUR_ALIPAY_PUBLIC_KEY_PLACEHOLDER

# 部署到服务器/内网穿透时改成公网地址
ALIPAY_NOTIFY_URL=http://localhost:8081/alipaycallback
ALIPAY_RETURN_URL=http://localhost:8081/alipayurl.html
